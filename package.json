{
  "name": "@sasjs/react-seed-app",
  "repository": "https://github.com/sasjs/react-seed-app",
  "description": "The SASjs React Seed App",
  "version": "2.0.0",
  "keywords": [
    "SAS",
    "SASViya",
    "SASjs"
  ],
  "main": "index.tsx",
  "homepage": ".",
  "scripts": {
    "start": "npx webpack-dev-server --config webpack.dev.js --open --hot",
    "build": "npx webpack --config webpack.prod.js",
    "deploy": "rsync -avhe ssh ./build/* --delete $SSH_ACCOUNT:$DEPLOY_PATH",
    "buildAndDeploy": "npm run build && npm run deploy",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,html,css,scss,less,json,yml,md,graphql}\" \"scripts/**/*.js\" \"sasjs/mocks/**/*.js\"",
    "lint": "prettier --check \"src/**/*.{ts,tsx,js,jsx,html,css,scss,less,json,yml,md,graphql}\" \"scripts/**/*.js\" \"sasjs/mocks/**/*.js\"",
    "test": "vitest run",
    "audit": "node scripts/audit-check.js",
    "prepare": "git rev-parse --git-dir && git config core.hooksPath ./.git-hooks || true",
    "mock:build": "npm run build && sasjs compile -t mock && sasjs build -t mock",
    "mock:start": "npx http-server ./sasjsbuild/mock -p 3001",
    "check:data": "node scripts/springs-data.js --check",
    "test:mock": "node scripts/check-mock-site.js"
  },
  "dependencies": {
    "@sasjs/adapter": "^6.1.0",
    "@sasjs/utils": "^4.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@sasjs/cli": "^6.28.0",
    "@sasjs/core": "^7.1.14",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.10",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "3.10.1",
    "sass": "^1.108.2",
    "sass-loader": "17.1.0",
    "semantic-release": "^25.0.9",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "eslintConfig": {
    "extends": "react-app",
    "overrides": [
      {
        "files": [
          "**/*.js"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
